@model MeuProjetoMVC.Models.Produto

@{
    ViewData["Title"] = "Detalhes";
}

<h1>Detalhes do produto</h1>

<div>
    <hr />
    @* dl/dt/dd é o "definition list" do HTML — ótimo para exibir pares chave/valor. *@
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Nome)</dt>
        <dd class="col-sm-10">@Model.Nome</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Descricao)</dt>
        <dd class="col-sm-10">@Model.Descricao</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Preco)</dt>
        <dd class="col-sm-10">@Model.Preco.ToString("C")</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Estoque)</dt>
        <dd class="col-sm-10">@Model.Estoque</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.CriadoEm)</dt>
        <dd class="col-sm-10">@Model.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit"  asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</div>
