@model MeuProjetoMVC.Models.Produto

@{
    ViewData["Title"] = "Editar produto";
}

<h1>Editar produto</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @*
                Hidden inputs para Id e CriadoEm — não queremos que o usuário edite,
                mas precisamos enviar de volta ao servidor para o EF reconhecer o registro.
            *@
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CriadoEm" />

            <div class="form-group mb-2">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="Descricao" class="control-label"></label>
                <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="Preco" class="control-label"></label>
                <input asp-for="Preco" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Preco" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Estoque" class="control-label"></label>
                <input asp-for="Estoque" class="form-control" type="number" />
                <span asp-validation-for="Estoque" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Salvar</button>
            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
