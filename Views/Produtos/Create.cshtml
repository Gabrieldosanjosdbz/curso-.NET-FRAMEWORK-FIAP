@model MeuProjetoMVC.Models.Produto

@{
    ViewData["Title"] = "Novo produto";
}

<h1>Novo produto</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        @*
            asp-action="Create" => o form vai postar para POST /Produtos/Create.
            O ValidateAntiForgeryToken no controller exige o token escondido — o
            Tag Helper de form já gera automaticamente.
        *@
        <form asp-action="Create" method="post">
            @* Mostra um resumo de erros (se houver) acima do form. *@
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-2">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control" />
                @* asp-validation-for renderiza o erro específico do campo. *@
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="Descricao" class="control-label"></label>
                <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="Preco" class="control-label"></label>
                <input asp-for="Preco" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Preco" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Estoque" class="control-label"></label>
                <input asp-for="Estoque" class="form-control" type="number" />
                <span asp-validation-for="Estoque" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Salvar</button>
            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        </form>
    </div>
</div>

@*
    @section Scripts injeta JS apenas nesta view. Aqui carregamos os scripts de
    validação client-side (jQuery Validate) — eles leem os atributos data-val
    gerados pelas DataAnnotations do Model.
*@
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
