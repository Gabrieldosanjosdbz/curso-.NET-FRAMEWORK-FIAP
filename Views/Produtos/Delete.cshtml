@model MeuProjetoMVC.Models.Produto

@{
    ViewData["Title"] = "Excluir produto";
}

<h1>Excluir produto</h1>

<h3 class="text-danger">Tem certeza que deseja excluir?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Nome)</dt>
        <dd class="col-sm-10">@Model.Nome</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Preco)</dt>
        <dd class="col-sm-10">@Model.Preco.ToString("C")</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Estoque)</dt>
        <dd class="col-sm-10">@Model.Estoque</dd>
    </dl>

    @*
        DELETE em HTML não é nativo — fazemos um POST para a action Delete (no servidor
        identificamos via [HttpPost, ActionName("Delete")]). O hidden Id vai pelo form.
    *@
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Excluir</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
